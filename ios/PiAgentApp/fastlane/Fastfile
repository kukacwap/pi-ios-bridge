# Fastlane configuration for PiAgentApp.
#
# Auth uses an App Store Connect API key (.p8) — no 2FA prompts, works headless.
# Required env vars (see ios/SUBMIT.md):
#   DEVELOPMENT_TEAM, BUNDLE_ID, ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH
# Optional:
#   BUILD_NUMBER      (defaults to a timestamp)
#   TESTER_EMAIL      Apple ID email to add as a TestFlight tester
#   TESTER_FIRST      tester first name (default "Pi")
#   TESTER_LAST       tester last name  (default "Tester")
#   TESTFLIGHT_GROUP  internal beta group name (default "Internal")

require "shellwords"

default_platform(:ios)

APP_SCHEME = "PiAgentApp"
PROJECT    = "PiAgentApp.xcodeproj"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
    in_house: false
  )
end

platform :ios do
  desc "Generate the Xcode project from project.yml (XcodeGen)"
  lane :generate do
    sh("command -v xcodegen >/dev/null || { echo 'install xcodegen: brew install xcodegen'; exit 1; }")
    Dir.chdir("..") { sh("xcodegen generate") }
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    generate
    api_key = asc_api_key
    team = ENV.fetch("DEVELOPMENT_TEAM")
    bundle = ENV.fetch("BUNDLE_ID")
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M%S")
    app_version  = ENV["APP_VERSION"] || "1.0"
    UI.message("Building version #{app_version} (#{build_number})")

    # Create/install a real App Store distribution certificate (avoids Apple's
    # cloud-managed signing, which the API key is not authorized to use).
    cert(api_key: api_key, platform: "ios")

    # Create/download an App Store provisioning profile for this bundle id.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bundle,
      # App Store profile (not adhoc/development)
      skip_fetch_profiles: false
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    build_app(
      project: PROJECT,
      scheme: APP_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "PiAgentApp.ipa",
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "MARKETING_VERSION=#{app_version}",
        "DEVELOPMENT_TEAM=#{team}",
        "PRODUCT_BUNDLE_IDENTIFIER=#{bundle}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=#{'Apple Distribution'.shellescape}",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile_name.shellescape}"
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team,
        provisioningProfiles: { bundle => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("BUNDLE_ID"),
      skip_waiting_for_build_processing: false,
      # Internal testing only: just upload + set export compliance. No beta review
      # or Beta App Description needed (those are for external testers).
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    # Auto-invite the tester if an email was provided (best-effort).
    if ENV["TESTER_EMAIL"]
      begin
        invite
      rescue => e
        UI.important("Tester invite skipped: #{e.message}")
      end
    end

    UI.success("Uploaded build #{build_number} to TestFlight.")
  end

  desc "Add a tester to the TestFlight group (no build upload)"
  lane :invite do
    require "spaceship"
    email = ENV.fetch("TESTER_EMAIL") do
      UI.user_error!("Set TESTER_EMAIL to the Apple ID you want to add as a tester")
    end
    group_name = ENV["TESTFLIGHT_GROUP"] || "Internal"
    first = ENV["TESTER_FIRST"] || "Pi"
    last  = ENV["TESTER_LAST"] || "Tester"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find(ENV.fetch("BUNDLE_ID"))
    UI.user_error!("App not found for #{ENV['BUNDLE_ID']}") unless app
    group = app.get_beta_groups.find { |g| g.name == group_name }
    UI.user_error!("Beta group '#{group_name}' not found. Create it in App Store Connect > TestFlight.") unless group

    begin
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [group.id],
        attributes: { email: email, firstName: first, lastName: last }
      )
      UI.success("Added #{email} to TestFlight group '#{group_name}'.")
    rescue => e
      case e.message
      when /already|exist|duplicate|ENTITY_ERROR/i
        UI.success("#{email} is already a tester in group '#{group_name}'.")
      when /cannot be assigned|state of another resource/i
        # Account Holder / existing ASC user: internal membership is managed in
        # the Users section of App Store Connect, not via the beta-tester API.
        UI.important("#{email} looks like a team user. Add them to the '#{group_name}' " \
                     "internal group once in App Store Connect > TestFlight > Internal Testing. " \
                     "After that, every build reaches them automatically.")
      else
        raise
      end
    end
  end

  desc "Just upload an already-built IPA at build/PiAgentApp.ipa"
  lane :upload_only do
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: ENV.fetch("BUNDLE_ID"),
      ipa: "build/PiAgentApp.ipa"
    )
  end
end
