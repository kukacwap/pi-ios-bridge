# Copy to .env and edit. Load with:  set -a; source .env; set +a; npm start
BRIDGE_TOKEN=change-me-to-a-long-random-secret
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787
BRIDGE_PROVIDER=ollama
BRIDGE_MODEL=qwen3-coder:latest
# Workspace the agent reads/writes in. Point at a project dir, not your home.
BRIDGE_CWD=/Users/kukacwap/agent-workspace
# Providers the app may switch to (keeps everything local):
LOCAL_PROVIDERS=ollama,llama-cpp,lmstudio,vllm
# Optional explicit pi path:
# PI_BIN=/Users/kukacwap/.pi/agent/bin/pi
