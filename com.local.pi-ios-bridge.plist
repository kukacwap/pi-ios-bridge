<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.pi-ios-bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kukacwap/pi-ios-bridge/run-bridge.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kukacwap/pi-ios-bridge</string>

    <!-- Start at login and keep it alive. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Logs -->
    <key>StandardOutPath</key>
    <string>/Users/kukacwap/pi-ios-bridge/bridge.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kukacwap/pi-ios-bridge/bridge.err.log</string>

    <!-- Give throttled restarts a small backoff. -->
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
